                  </svg>
                </div>
                <p class="text-xl md:text-2xl text-[var(--dark-brown)] mb-8 leading-relaxed">
                  "The Dates Sparkling Drink is absolutely refreshing! Perfect blend of natural sweetness and fizz. My family loves it, and we always keep a few bottles in the fridge. Great value for money!"
                </p>
                <p class="text-lg font-semibold text-[var(--burgundy)] uppercase tracking-wide">PRIYA SHARMA</p>
              </div>
            </div>

            <!-- Review 2 -->
            <div class="min-w-full px-4 md:px-8">
              <div class="bg-white rounded-lg p-8 md:p-12 max-w-4xl mx-auto text-center border border-gray-100 shadow-lg">
                <div class="flex justify-center mb-6">
                  <svg class="w-6 h-6 text-[var(--burgundy)]" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  <svg class="w-6 h-6 text-[var(--burgundy)]" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
