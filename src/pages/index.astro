        </span>
        <h2 class="text-5xl md:text-6xl font-black text-[var(--dark-brown)] mb-6">Why Choose Highfields?</h2>
        <p class="text-xl text-[var(--brown)] max-w-2xl mx-auto">Quality and tradition in every product</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <!-- Premium Quality -->
        <div class="text-center p-10 bg-white rounded-3xl shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 border border-gray-100">
          <div class="w-24 h-24 bg-gradient-to-br from-[var(--burgundy)] to-[var(--burgundy)]/80 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
            <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-[var(--dark-brown)] mb-4">Premium Quality</h3>
          <p class="text-lg text-[var(--brown)] leading-relaxed">
            Only the finest ingredients sourced with care for exceptional taste and nutrition
          </p>
        </div>

        <!-- Traditional Roots -->
        <div class="text-center p-10 bg-white rounded-3xl shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 border border-gray-100">
          <div class="w-24 h-24 bg-gradient-to-br from-[var(--forest-green)] to-[var(--forest-green)]/80 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
            <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-[var(--dark-brown)] mb-4">Traditional Roots</h3>
          <p class="text-lg text-[var(--brown)] leading-relaxed">
            Honoring time-tested methods while bringing innovation to every product
          </p>
        </div>

        <!-- Customer Focus -->
        <div class="text-center p-10 bg-white rounded-3xl shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 border border-gray-100">
          <div class="w-24 h-24 bg-gradient-to-br from-[var(--orange)] to-[var(--orange)]/80 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
            <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-[var(--dark-brown)] mb-4">Made with Care</h3>
          <p class="text-lg text-[var(--brown)] leading-relaxed">
            Every product is crafted with attention to detail and genuine passion
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What People Say Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="inline-block px-12 py-4 bg-[var(--burgundy)]/10 text-[var(--burgundy)] text-sm font-semibold rounded-full mb-4">
          CUSTOMER REVIEWS
        </span>
        <h2 class="text-5xl md:text-6xl font-black text-[var(--dark-brown)] mb-6">What People Say</h2>
        <p class="text-xl text-[var(--brown)] max-w-2xl mx-auto">Hear from our happy customers across India</p>
      </div>

      <div class="relative">
        <!-- Reviews Carousel -->
        <div class="overflow-hidden">
          <div id="reviews-track" class="flex transition-transform duration-500 ease-out">
            <!-- Review 1 -->
            <div class="min-w-full px-4 md:px-8">
              <div class="bg-white rounded-lg p-8 md:p-12 max-w-4xl mx-auto text-center border border-gray-100 shadow-lg">
                <div class="flex justify-center mb-6">
