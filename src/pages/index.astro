---
import Layout from '../components/Layout.astro';
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center justify-center bg-gradient-to-br from-[var(--cream)] via-white to-[var(--orange)]/5 overflow-hidden pt-6 pb-16">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-40"></div>

    <div class="w-full max-w-7xl mx-auto px-8 sm:px-12 lg:px-16 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center" style="column-gap: clamp(3rem, 8rem, 8rem);">
        <!-- Text Content -->
        <div class="text-center lg:text-left flex flex-col justify-center" style="animation: fadeInUp 0.8s ease-out;">
          <div class="inline-block px-12 py-4 bg-[var(--burgundy)] text-white text-sm font-semibold rounded-full mb-8 shadow-lg mx-auto lg:mx-0 w-fit">
            Premium Quality Since 2015
          </div>
          <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-[var(--dark-brown)] leading-[1.1] mb-8" style="font-family: 'Shrikhand', sans-serif;">
            Shake Up<br />
            Your Day,<br />
            <span class="text-[var(--burgundy)] block mt-3">the Highfields Way!</span>
          </h1>
          <p class="text-lg sm:text-xl md:text-2xl text-[var(--brown)] mb-12 leading-relaxed mx-auto lg:mx-0 max-w-xl">
            Experience the natural sweetness of dates in every sip. <span class="font-semibold">Bold. Refreshing. Unexpected.</span>
          </p>
          <div class="flex flex-col sm:flex-row gap-5 justify-center lg:justify-start">
            <a
              href={`${import.meta.env.BASE_URL}products`}
              class="inline-block bg-[var(--burgundy)] text-white px-10 py-6 rounded-full font-bold text-lg hover:bg-[var(--brown)] transform hover:scale-105 transition-all duration-300 shadow-xl hover:shadow-2xl text-center whitespace-nowrap"
            >
              Explore Products
            </a>
            <a
              href={`${import.meta.env.BASE_URL}about`}
              class="inline-block border-3 border-[var(--burgundy)] text-[var(--burgundy)] px-10 py-6 rounded-full font-bold text-lg hover:bg-[var(--burgundy)] hover:text-white transform hover:scale-105 transition-all duration-300 text-center whitespace-nowrap"
              style="border-width: 3px;"
            >
              Our Story
            </a>
          </div>
        </div>

        <!-- Product Image -->
        <div class="relative flex items-center justify-center" style="animation: fadeInRight 1s ease-out;">
          <div id="product-media-container" class="relative w-full mx-auto cursor-pointer aspect-[5/6]">
            <!-- Decorative circle background -->
            <div class="absolute inset-0 bg-gradient-to-br from-[var(--burgundy)]/20 to-[var(--orange)]/20 rounded-full blur-3xl scale-110"></div>
            <div class="absolute -inset-4 bg-[var(--burgundy)]/10 rounded-full blur-2xl animate-pulse"></div>

            <img
              id="product-image"
              src={`${import.meta.env.BASE_URL}images/Highfields_sparkling_drink_date_animation_last_frame.png`}
              alt="Highfields Dates Sparkling Drink"
              class="absolute inset-0 z-10 w-full h-full object-cover object-top drop-shadow-2xl transition-all duration-500 ease-out rounded-3xl"
              style="filter: drop-shadow(0 25px 50px rgba(139, 38, 53, 0.3));"
            />
            <video
              id="product-video"
              src={`${import.meta.env.BASE_URL}videos/Highfields_sparkling_drink_date_animation.mp4`}
              class="absolute inset-0 z-20 w-full h-full object-cover drop-shadow-2xl transition-all duration-500 ease-out opacity-0 pointer-events-none rounded-3xl"
              style="filter: drop-shadow(0 25px 50px rgba(139, 38, 53, 0.3)); object-position: center -45%;"
              playsinline
            ></video>
          </div>
        </div>
      </div>
    </div>

    <!-- Add keyframe animations -->
    <style>
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes fadeInRight {
        from {
          opacity: 0;
          transform: translateX(30px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }
    </style>

    <!-- Product media script -->
    <script>
      const container = document.getElementById('product-media-container');
      const image = document.getElementById('product-image');
      const video = document.getElementById('product-video') as HTMLVideoElement;

      // Detect if device is mobile/touch-enabled
      const isMobile = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

      if (isMobile) {
        // Mobile: Use Intersection Observer
        let hasPlayed = false;

        const playVideo = () => {
          if (video) {
            video.classList.remove('opacity-0', 'pointer-events-none');
            video.classList.add('opacity-100');
            video.play();

            // When video ends, hide it and show image
            const handleEnded = () => {
              video.classList.remove('opacity-100');
              video.classList.add('opacity-0', 'pointer-events-none');
              video.currentTime = 0;
            };

            video.addEventListener('ended', handleEnded, { once: true });
          }
        };

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && entry.intersectionRatio === 1.0) {
                // Container is fully visible
                if (!hasPlayed) {
                  hasPlayed = true;
                  playVideo();
                }
              } else {
                // Container left viewport - reset for next time
                hasPlayed = false;
              }
            });
          },
          {
            threshold: 1.0 // Trigger only when 100% of container is visible
          }
        );

        if (container) {
          observer.observe(container);

          // Add click handler to replay video
          container.addEventListener('click', () => {
            playVideo();
          });
        }
      } else {
        // Desktop: Use hover behavior with looping
        container?.addEventListener('mouseenter', () => {
          if (video) {
            video.loop = true; // Enable looping for desktop
            video.classList.remove('opacity-0', 'pointer-events-none');
            video.classList.add('opacity-100');
            video.play();
          }
        });

        container?.addEventListener('mouseleave', () => {
          if (video) {
            video.pause();
            video.currentTime = 0;
            video.loop = false; // Disable looping when not hovering
            video.classList.remove('opacity-100');
            video.classList.add('opacity-0', 'pointer-events-none');
          }
        });
      }
    </script>
  </section>

  <!-- Tagline Section -->
  <section class="py-16 bg-[var(--burgundy)] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Food For Thought</h2>
      <p class="text-xl opacity-90">
        Where tradition meets innovation in every refreshing moment
      </p>
    </div>
  </section>

  <!-- Featured Product Section -->
  <section class="py-18 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="inline-block px-12 py-4 bg-[var(--orange)]/10 text-[var(--orange)] text-sm font-semibold rounded-full mb-4">
          SPOTLIGHT
        </span>
        <h2 class="text-5xl md:text-6xl font-black text-[var(--dark-brown)] mb-6">Featured Product</h2>
        <p class="text-xl text-[var(--brown)] max-w-2xl mx-auto">Discover our signature Dates Sparkling Drink</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center bg-gradient-to-br from-[var(--cream)] to-white rounded-3xl p-8 md:p-16 shadow-2xl">
        <div class="order-2 lg:order-1">
          <h3 class="text-4xl md:text-5xl font-black text-[var(--dark-brown)] mb-6 leading-tight">
            Dates Sparkling<br />Drink
          </h3>
          <p class="text-lg md:text-xl text-[var(--brown)] mb-8 leading-relaxed">
            Experience a unique blend of natural date palm juice concentrate with a refreshing fizzy twist.
            Our sparkling drink captures the authentic sweetness of dates while delivering an unexpected
            carbonated sensation.
          </p>
          <ul class="space-y-5 mb-10">
            <li class="flex items-start text-lg md:text-xl">
              <svg class="w-8 h-8 text-[var(--forest-green)] mr-4 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-[var(--brown)]"><strong class="text-[var(--dark-brown)]">Bold & Refreshing</strong> flavor</span>
            </li>
            <li class="flex items-start text-lg md:text-xl">
              <svg class="w-8 h-8 text-[var(--forest-green)] mr-4 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-[var(--brown)]">Natural <strong class="text-[var(--dark-brown)]">date palm juice</strong></span>
            </li>
            <li class="flex items-start text-lg md:text-xl">
              <svg class="w-8 h-8 text-[var(--forest-green)] mr-4 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-[var(--brown)]"><strong class="text-[var(--dark-brown)]">Premium Quality</strong> ingredients</span>
            </li>
            <li class="flex items-start text-lg md:text-xl">
              <svg class="w-8 h-8 text-[var(--forest-green)] mr-4 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-[var(--brown)]"><strong class="text-[var(--dark-brown)]">250ml</strong> perfect serving</span>
            </li>
          </ul>
          <a
            href={`${import.meta.env.BASE_URL}products`}
            class="inline-block bg-[var(--orange)] text-white px-16 py-6 rounded-full font-bold text-lg hover:bg-[var(--burgundy)] transform hover:scale-105 transition-all duration-300 shadow-xl"
          >
            View All Products
          </a>
        </div>

        <div class="order-1 lg:order-2 flex justify-center">
          <div class="relative">
            <div class="absolute inset-0 bg-[var(--burgundy)]/10 rounded-3xl blur-2xl"></div>
            <img
              src={`${import.meta.env.BASE_URL}images/Highfields_Dates_Sparkling_Drink.jpeg`}
              alt="Dates Sparkling Drink"
              class="relative z-10 w-full max-w-md mx-auto rounded-2xl shadow-2xl hover:scale-105 transition-transform duration-500"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-24 bg-gradient-to-b from-[var(--cream)] to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <span class="inline-block px-12 py-4 bg-[var(--burgundy)]/10 text-[var(--burgundy)] text-sm font-semibold rounded-full mb-4">
