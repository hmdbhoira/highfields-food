  <!-- Reviews Carousel Script -->
  <script>
    let currentReview = 0;
    const totalReviews = 4;
    const track = document.getElementById('reviews-track');
    const dots = document.querySelectorAll('.review-dot');
    const prevBtn = document.getElementById('prev-review');
    const nextBtn = document.getElementById('next-review');
    let reviewInterval;

    function updateCarousel() {
      if (track) {
        track.style.transform = `translateX(-${currentReview * 100}%)`;
      }

      dots.forEach((dot, index) => {
        if (index === currentReview) {
          dot.classList.remove('bg-gray-300');
          dot.classList.add('bg-[var(--burgundy)]');
        } else {
          dot.classList.remove('bg-[var(--burgundy)]');
          dot.classList.add('bg-gray-300');
        }
      });
    }

    function startAutoAdvance() {
      clearInterval(reviewInterval);
      reviewInterval = setInterval(() => {
        currentReview = (currentReview + 1) % totalReviews;
        updateCarousel();
      }, 5000);
    }

    prevBtn?.addEventListener('click', () => {
      currentReview = (currentReview - 1 + totalReviews) % totalReviews;
      updateCarousel();
      startAutoAdvance();
    });

    nextBtn?.addEventListener('click', () => {
      currentReview = (currentReview + 1) % totalReviews;
      updateCarousel();
      startAutoAdvance();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        currentReview = parseInt(dot.dataset.index || '0');
        updateCarousel();
        startAutoAdvance();
      });
    });

    // Start auto-advance
    startAutoAdvance();
  </script>

  <!-- Stores Carousel Script -->
  <script>
    const storesTrack = document.getElementById('stores-track');
    const prevStoreBtn = document.getElementById('prev-store');
    const nextStoreBtn = document.getElementById('next-store');
    let scrollPosition = 0;
    const scrollAmount = 280; // Width of one card + gap
    let storeInterval;
    let isScrolling = false;

    if (storesTrack) {
      const singleSetWidth = storesTrack.scrollWidth / 2; // Width of one complete set

      function scroll(direction) {
        if (isScrolling) return;
        isScrolling = true;

        scrollPosition += direction * scrollAmount;
        storesTrack.style.transform = `translateX(-${scrollPosition}px)`;

        // Seamlessly reset position for infinite loop
        setTimeout(() => {
          if (scrollPosition >= singleSetWidth) {
            // Disable transition, reset position, re-enable transition
            storesTrack.style.transition = 'none';
            scrollPosition = 0;
            storesTrack.style.transform = `translateX(-${scrollPosition}px)`;

            // Force reflow
            storesTrack.offsetHeight;
            storesTrack.style.transition = 'transform 500ms ease-out';
          } else if (scrollPosition < 0) {
            storesTrack.style.transition = 'none';
            scrollPosition = singleSetWidth - scrollAmount;
            storesTrack.style.transform = `translateX(-${scrollPosition}px)`;

            storesTrack.offsetHeight;
            storesTrack.style.transition = 'transform 500ms ease-out';
          }
          isScrolling = false;
        }, 500);
      }

      function startAutoAdvance() {
        clearInterval(storeInterval);
        storeInterval = setInterval(() => scroll(1), 3000);
      }

      prevStoreBtn?.addEventListener('click', () => {
        scroll(-1);
        startAutoAdvance();
      });

      nextStoreBtn?.addEventListener('click', () => {
        scroll(1);
        startAutoAdvance();
      });

      // Start auto-advance
