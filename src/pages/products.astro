---

<Layout title="Products">
  <!-- Page Header -->
  <section class="py-16 bg-gradient-to-br from-[var(--burgundy)] to-[var(--brown)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl font-bold mb-4">Our Products</h1>
      <p class="text-xl opacity-90 max-w-2xl mx-auto">
        Discover our range of premium dates, refreshing beverages, pure honey, berries, nuts, and healthy snacks
      </p>
    </div>
  </section>

  <!-- Category Navigation -->
  <div class="sticky top-16 sm:top-20 z-40 bg-white shadow-md py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-center gap-3">
        <a href="#beverages" class="category-link px-6 py-2 rounded-full bg-[var(--cream)] text-[var(--dark-brown)] font-semibold hover:bg-[var(--burgundy)] hover:text-white transition-colors">
          Beverages
        </a>
        <a href="#dates" class="category-link px-6 py-2 rounded-full bg-[var(--cream)] text-[var(--dark-brown)] font-semibold hover:bg-[var(--burgundy)] hover:text-white transition-colors">
          Dates
        </a>
        <a href="#honey" class="category-link px-6 py-2 rounded-full bg-[var(--cream)] text-[var(--dark-brown)] font-semibold hover:bg-[var(--burgundy)] hover:text-white transition-colors">
          Honey
        </a>
        <a href="#nuts" class="category-link px-6 py-2 rounded-full bg-[var(--cream)] text-[var(--dark-brown)] font-semibold hover:bg-[var(--burgundy)] hover:text-white transition-colors">
          Nuts
        </a>
        <a href="#berries" class="category-link px-6 py-2 rounded-full bg-[var(--cream)] text-[var(--dark-brown)] font-semibold hover:bg-[var(--burgundy)] hover:text-white transition-colors">
          Berries
        </a>
        <a href="#snacks" class="category-link px-6 py-2 rounded-full bg-[var(--cream)] text-[var(--dark-brown)] font-semibold hover:bg-[var(--burgundy)] hover:text-white transition-colors">
          Snacks
        </a>
      </div>
    </div>
  </div>

  <!-- Products Grid -->
  <section class="py-20 bg-[var(--cream)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Beverages Section -->
      <div id="beverages" class="mb-16 scroll-mt-32">
        <h2 class="text-3xl font-bold text-[var(--dark-brown)] mb-8">Beverages</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {products.filter(p => p.category === 'Beverages').map((product) => (
            <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-shadow relative">
              {/* Coming Soon Badge */}
              {product.isUpcoming && (
                <div class="absolute top-4 left-4 z-10">
                  <span class="bg-[var(--orange)] text-white px-4 py-2 rounded-full text-sm font-semibold">
                    Coming Soon
                  </span>
                </div>
              )}

              {/* Out of Stock Badge */}
              {product.isOutOfStock && (
                <div class="absolute top-4 left-4 z-10">
                  <span class="bg-gray-500 text-white px-4 py-2 rounded-full text-sm font-semibold">
                    Out of Stock
                  </span>
                </div>
              )}

              <div class="relative h-96 bg-gradient-to-br from-[var(--cream)] to-white flex items-center justify-center p-8">
                <img
                  src={product.image}
                  alt={product.name}
                  class={`h-80 w-80 object-contain ${product.isOutOfStock ? 'opacity-50' : ''}`}
                />
              </div>

              <div class="p-6">
                <div class="flex justify-between items-start mb-4">
                  <h3 class="text-2xl font-bold text-[var(--dark-brown)]">{product.name}</h3>
                  <span class="text-sm text-[var(--brown)] bg-[var(--cream)] px-3 py-1 rounded-full">
                    {product.size}
                  </span>
                </div>

                <p class="text-[var(--brown)] mb-6">{product.description}</p>

                <div class="space-y-2 mb-6">
                  {product.features.map((feature) => (
                    <div class="flex items-center text-sm text-[var(--brown)]">
                      <svg class="w-5 h-5 text-[var(--forest-green)] mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      {feature}
                    </div>
                  ))}
                </div>

                {product.isOutOfStock ? (
                  <button
                    disabled
                    class="block w-full text-center bg-gray-400 text-white py-3 rounded-lg font-semibold cursor-not-allowed"
                  >
                    Currently Unavailable
                  </button>
                ) : (
                  <a
                    href={`${import.meta.env.BASE_URL}contact`}
                    class="block w-full text-center bg-[var(--burgundy)] text-white py-3 rounded-lg font-semibold hover:bg-[var(--brown)] transition-colors"
                  >
                    Contact for Orders
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Dates Section -->
      <div id="dates" class="mb-16 scroll-mt-32">
        <h2 class="text-3xl font-bold text-[var(--dark-brown)] mb-8">Dates</h2>
